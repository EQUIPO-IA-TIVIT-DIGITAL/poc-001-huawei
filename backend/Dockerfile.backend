# Backend solo (sin supervisord) — local offline 32B
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg=7:5.1* libmagic1 curl tini && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 -s /bin/bash appuser
WORKDIR /app
COPY requirements.txt .
# gunicorn pinneado — no latest
RUN pip install --no-cache-dir gunicorn==23.0.0
COPY --chown=appuser:appuser . .
RUN mkdir -p /app/uploads /app/thumbnails /app/logs && chown -R appuser:appuser /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 FLASK_APP=main.py PORT=5000
EXPOSE 5000
USER appuser
HEALTHCHECK --interval=30s --timeout=10s --retries=3 CMD curl -f http://localhost:5000/health || exit 1
ENTRYPOINT ["tini", "--"]
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "--threads", "8", "--worker-class", "gthread", "--timeout", "300", "--graceful-timeout", "30", "--log-level", "info", "main:create_app()"]
