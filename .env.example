# Application
APP_ENV=local
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-64-character-minimum-secret
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SESSION_COOKIE_SECURE=false

# Backend runtime
PORT=5000
PYTHONUNBUFFERED=1
REQUIRE_ASYNC_QUEUE=true
WORKER_INTERNAL_TOKEN=replace-with-a-random-internal-worker-token

# Database
POSTGRES_DB=cu002
POSTGRES_USER=cu002
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+psycopg2://cu002:replace-with-a-strong-postgres-password@postgres:5432/cu002
DB_BACKEND=postgres
PGVECTOR_ENABLED=true

# Redis
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0

# Storage / MinIO
STORAGE_BACKEND=minio
MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-secret-key
S3_ENDPOINT=http://minio:9000
S3_BUCKET=cu002-videos
S3_ACCESS_KEY=replace-with-minio-access-key
S3_SECRET_KEY=replace-with-a-strong-minio-secret-key
S3_REGION=us-east-1
S3_USE_SSL=false

# AI providers
AI_PROVIDER=hybrid
AI_API_PROVIDER=openrouter
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_API_MODEL=qwen2.5-vl-32b
AI_API_TEXT_MODEL=qwen/qwen-2.5-72b-instruct
AI_API_VISION_MODEL=qwen/qwen-2.5-vl-72b-instruct
AI_API_EMBEDDING_MODEL=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=TIVIT CU002
AI_LOCAL_BASE_URL=http://vllm-vision:8000/v1
AI_LOCAL_MODEL=Qwen/Qwen2.5-VL-32B-Instruct-AWQ
AI_LOCAL_TEXT_BASE_URL=http://vllm-text:8000/v1
AI_LOCAL_TEXT_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
AI_LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
WHISPER_BASE_URL=http://whisper:9000
WHISPER_MODEL=large-v3-turbo

# Model/runtime sizing
VLLM_TENSOR_PARALLEL_SIZE=4
VLLM_GPU_MEMORY_UTILIZATION=0.92
VLLM_MAX_MODEL_LEN=8192

# Frontend
VITE_API_BASE_URL=http://localhost:5001

# Optional local utilities
DEMO_USER_PASSWORD=replace-with-local-demo-password

# Optional file logging. Empty means stdout/stderr only.
LOG_FILE=
SECURITY_LOG_TO_FILE=false
